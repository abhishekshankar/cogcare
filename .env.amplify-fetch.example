# Copy to `.env.amplify-fetch` in the repo root (gitignored) and fill in values.
# App ID is in the Amplify console URL: .../apps/<THIS_PART>/...
AMPLIFY_APP_ID=
AMPLIFY_BRANCH=
# Optional: pin a specific job (decimal string from the console or list-jobs)
# AMPLIFY_JOB_ID=
# Optional: output path (default: docs/amplify-build-export.md)
# AMPLIFY_LOG_OUT=docs/amplify-build-export.md
